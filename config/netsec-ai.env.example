# Save as /etc/netsec-ai.env, root:statusdash 0640. NEVER commit real values.
OWUI_URL=https://ai.example.org
OWUI_MODEL=your-local-model
OWUI_KEY=REPLACE_WITH_DEDICATED_OPEN_WEBUI_KEY
NETSEC_PUBLIC_URL=https://netsec.example.org/
NETSEC_SOURCE_AI_BATCHES=4
NETSEC_SOURCE_AI_BATCH_SIZE=10
# Optional SMTP advisory; not a push-notification system.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
