# Copy to /etc/netsec-ai.env, then chown root:statusdash and chmod 0640.
# No secrets are included in NetSec source. Never commit populated values.
# Choose one provider: openai or openwebui. User's own key is REQUIRED.
NETSEC_AI_PROVIDER=openwebui
# Direct OpenAI: https://api.openai.com
# Local Open WebUI: e.g. http://192.168.1.20:3000 or https://ai.example.net
NETSEC_AI_URL=https://ai.example.net
NETSEC_AI_MODEL=your-local-model
NETSEC_AI_KEY=REPLACE_WITH_YOUR_OWN_API_KEY
NETSEC_ASSISTANT_NAME="Jimmy"
NETSEC_PUBLIC_URL=https://netsec.example.org/
NETSEC_SOURCE_AI_BATCHES=4
NETSEC_SOURCE_AI_BATCH_SIZE=10
# Legacy OWUI_URL / OWUI_MODEL / OWUI_KEY names remain supported.
# Automated API requests may incur costs with OpenAI. Sampled security telemetry
# is sent to the selected endpoint. Disable timers to stop scheduled requests.
# Optional email only; not a push notification feature.
# SMTP_HOST=
# SMTP_PORT=587
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
