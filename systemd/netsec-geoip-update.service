[Unit]
Description=Refresh offline DB-IP Country Lite database for NetSec
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=statusdash
Group=statusdash
ExecStart=/usr/bin/python3 /opt/server-status/geoip_update.py
TimeoutStartSec=240
UMask=0027
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/server-status
CapabilityBoundingSet=
