[Unit]
Description=NetSec v1.0.1 dashboard
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=statusdash
Group=statusdash
WorkingDirectory=/opt/server-status
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ALLOW_REMOTE_BIND=YES
Environment=STATUS_CONFIG=/opt/server-status/config.json
Environment=NETSEC_JIMMY_CONTEXT=/opt/server-status/operator-context.json
ExecStart=/usr/bin/python3 /opt/server-status/app.py
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/server-status
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
