[Unit]
Description=Jimmy evidence-calibrated AI security assessment
Wants=network-online.target
After=network-online.target server-status.service
[Service]
Type=oneshot
User=statusdash
Group=statusdash
WorkingDirectory=/opt/server-status
EnvironmentFile=/etc/netsec-ai.env
Environment=STATUS_CONFIG=/opt/server-status/config.json
Environment=NETSEC_JIMMY_CONTEXT=/opt/server-status/operator-context.json
ExecStart=/usr/bin/python3 /opt/server-status/netsec_ai.py
TimeoutStartSec=500
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/server-status/ai /var/lib/server-status/intel
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
